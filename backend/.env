# Neon PostgreSQL connection string (your teammate will provide this)
DATABASE_URL=""

# JWT Configuration
JWT_SECRET="transitops-hackathon-secret-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=3000

# Frontend origin (for CORS)
CLIENT_URL="http://localhost:5173"
